@model IEnumerable<MantenanceProjetASPNET6.Models.SearchModel3>

@using NonFactors.Mvc.Grid;
@{
    ViewData["Title"] = "ListPresent4eme";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<head>
    <link href="~/css/mvc-grid/mvc-grid.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>

<div>
    <!-- Tableau Grid MVC -->
    @(
        Html.Grid(Model).Build(columns =>
        {
            columns.Add(model => model.Cne).Titled("CNE").Css("text-center");
            columns.Add(model => model.Cin).Titled("CNI").Css("text-center");
            columns.Add(model => model.Nom).Titled("Nom").Css("text-center");
            columns.Add(model => model.Prenom).Titled("Prenom").Css("text-center");
            columns.Add(model => model.Matricule).Titled("Matricule").Css("text-center");
            // Ajouter une colonne pour appliquer une classe CSS conditionnelle
            columns.Add(model => model.Adress).Titled("Adress");
        })
        .Empty("No data found")
        .Pageable(pager =>
        {
            pager.RowsPerPage = 6;
        })
        .Filterable()
        .Sortable()
        .Css("table table-striped table-bordered my-grid")
        .Id("tbody")
        )
</div>

<!-- Bouton pour exporter en Excel -->

<div class="text-center mt-3">
    <button class="btn btn-success" onclick="exportTableToExcel('my-grid')">Exporter en Excel</button>
</div>


<script src="~/js/mvc-grid/mvc-grid.js"></script>
<script>
    document.querySelectorAll(".mvc-grid").forEach(Element => new MvcGrid(Element));
    //######################## Export to EXCELL #########
             function getFilteredTableData() {
        // Get the MVC grid instance
        const grid = document.querySelector('.mvc-grid');
        const mvcGrid = new MvcGrid(grid);

        // Get all rows from the grid body
        const tbody = grid.querySelector('tbody');
        const rows = Array.from(tbody.getElementsByTagName('tr'));

        // Filter only visible rows (not filtered out)
        const visibleRows = rows.filter(row => {
            const style = window.getComputedStyle(row);
            return style.display !== 'none' && !row.classList.contains('mvc-grid-empty-row');
        });

        return visibleRows;
    }

    function exportTableToExcel(tableID) {
        var downloadLink;
        var dataType = 'application/vnd.ms-excel';

        // Get the MVC grid
        var tableSelect = document.querySelector('.mvc-grid');

        // Create a new table for export
        var exportTable = document.createElement('table');

        // Copy header row but skip action columns
        var headerRow = document.createElement('tr');
        var originalHeaders = tableSelect.getElementsByTagName('th');

        // Skip the first column (Convoque button)
        for(let i = 1; i < originalHeaders.length; i++) {
            let newHeader = document.createElement('th');
            // Get the header text without the sort arrows
            let headerText = originalHeaders[i].querySelector('.mvc-grid-header');
            newHeader.textContent = headerText ? headerText.textContent.trim() : originalHeaders[i].textContent.trim();
            headerRow.appendChild(newHeader);
        }

        var thead = document.createElement('thead');
        thead.appendChild(headerRow);
        exportTable.appendChild(thead);

        // Create new tbody
        var tbody = document.createElement('tbody');

        // Get filtered rows
        var filteredRows = getFilteredTableData();

        // Add filtered rows to new table, excluding action columns
        filteredRows.forEach(row => {
            let newRow = document.createElement('tr');
            let cells = row.getElementsByTagName('td');

            // Skip the first column (Convoque button)
            for(let i = 1; i < cells.length; i++) {
                let newCell = document.createElement('td');
                // Handle cells with images
                if(cells[i].querySelector('img')) {
                    newCell.textContent = 'Photo';
                } else {
                    newCell.textContent = cells[i].textContent.trim();
                }
                newRow.appendChild(newCell);
            }
            tbody.appendChild(newRow);
        });

        exportTable.appendChild(tbody);

        // Convert table to Excel format
        var tableHTML = exportTable.outerHTML.replace(/ /g, '%20');

        // Specify file name
        filename = "ListePresence4.xls";

        // Create download link element
        downloadLink = document.createElement("a");
        document.body.appendChild(downloadLink);

        if(navigator.msSaveOrOpenBlob) {
            var blob = new Blob(['\ufeff', tableHTML], {
                type: dataType
            });
            navigator.msSaveOrOpenBlob(blob, filename);
        } else {
            // Create a link to the file
            downloadLink.href = 'data:' + dataType + ', ' + tableHTML;

            // Setting the file name
            downloadLink.download = filename;

            //triggering the function
            downloadLink.click();
        }

        // Clean up
        document.body.removeChild(downloadLink);
    }

    // Initialize MVC Grid and export button
    document.addEventListener('DOMContentLoaded', function() {
        // Initialize all MVC grids on the page
        document.querySelectorAll(".mvc-grid").forEach(element => new MvcGrid(element));
    });

    //#########################################################
</script>
